# Configuración local de Argos (INV-ARCH-006). Sin secretos.
# Copiar a .env y ajustar si es necesario. Solo src/infrastructure/config/ lee estas variables.
PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/argos.sqlite
APP_TIMEZONE=America/Bogota
COOKIE_SECURE=false
# Límites de frecuencia por persona (ADR-002-12): exportación e invitación, en una ventana deslizante de minutos.
EXPORT_MAX_PER_WINDOW=5
EXPORT_WINDOW_MINUTES=15
INVITE_MAX_PER_WINDOW=20
INVITE_WINDOW_MINUTES=15
ARGOS_AUDIT_RETENTION_DAYS=730
# Clave HMAC de la seudonimización de la auditoría (REQ-AUD-001, SC-014). OBLIGATORIA en todo entorno salvo NODE_ENV=test.
# Debe ser hexadecimal de 64 o más caracteres (longitud par, >= 32 bytes). Genérala con: openssl rand -hex 32
# La línea de abajo está comentada a propósito (marcador, NO es una clave válida): descoméntala y reemplaza el valor en tu .env local; no lo subas al repositorio.
# ARGOS_AUDIT_HMAC_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES_GENERADOS_LOCALMENTE
