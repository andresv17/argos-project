# Configuración local de Argos (INV-ARCH-006). Sin secretos.
# Copiar a .env y ajustar si es necesario. Solo src/infrastructure/config/ lee estas variables.
PORT=3100
# HOST: 127.0.0.1 por defecto. 0.0.0.0 solo con NODE_ENV=production o ARGOS_DB_DRIVER=postgres (D-26). Vacío se rechaza.
HOST=127.0.0.1
DATABASE_PATH=./data/argos.sqlite
APP_TIMEZONE=America/Bogota
COOKIE_SECURE=false
# Límites de frecuencia por persona (ADR-002-12): exportación e invitación, en una ventana deslizante de minutos.
EXPORT_MAX_PER_WINDOW=5
EXPORT_WINDOW_MINUTES=15
INVITE_MAX_PER_WINDOW=20
INVITE_WINDOW_MINUTES=15
# Duplicados de microchip por persona (REQ-PET4-002, ADR-004-04): tope y ventana deslizante en minutos (1440 = 24 h).
MICROCHIP_DUPLICATE_MAX_PER_WINDOW=5
MICROCHIP_DUPLICATE_WINDOW_MINUTES=1440
ARGOS_AUDIT_RETENTION_DAYS=730
# Persistencia (REQ-PG-010): sqlite (defecto), postgres o memory (solo NODE_ENV=test o staging).
ARGOS_DB_DRIVER=sqlite
# Tamaño máximo del pool de PostgreSQL: entero de 1 a 10.
ARGOS_PG_POOL_MAX=5
# Con ARGOS_DB_DRIVER=postgres, DATABASE_URL es obligatoria y debe incluir sslmode=require (REQ-CLD-005). Es un secreto: no se versiona.
# Comentada a propósito (marcador sin credenciales reales): descoméntala y complétala solo en tu entorno.
# DATABASE_URL=postgres://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require
# Clave HMAC de la seudonimización de la auditoría (REQ-AUD-001, SC-014). OBLIGATORIA en todo entorno salvo NODE_ENV=test.
# Debe ser hexadecimal de 64 o más caracteres (longitud par, >= 32 bytes). Genérala con: openssl rand -hex 32
# La línea de abajo está comentada a propósito (marcador, NO es una clave válida): descoméntala y reemplaza el valor en tu .env local; no lo subas al repositorio.
# ARGOS_AUDIT_HMAC_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES_GENERADOS_LOCALMENTE
# Con ARGOS_DB_DRIVER=postgres son obligatorias ARGOS_SCHEDULER_EMAIL (cuenta *.iam.gserviceaccount.com del Scheduler) y
# ARGOS_OIDC_AUDIENCE (URL https del servicio, sin credenciales). Solo comentadas, sin valor (R-A).
# ARGOS_SCHEDULER_EMAIL=
# ARGOS_OIDC_AUDIENCE=
# Medios (REQ-GCS-003, SC-ALM-023): driver memory (desarrollo) o gcs (obligatorio con NODE_ENV=production, junto con ARGOS_MEDIA_BUCKET).
ARGOS_MEDIA_DRIVER=memory
# ARGOS_MEDIA_BUCKET=
# URL firmada de lectura: caducidad en segundos (30-900); archivo <= 10485760 bytes (10 MiB); cuota por propietario (1 GiB); subidas simultaneas (1-8).
ARGOS_MEDIA_SIGNED_URL_TTL_SECONDS=300
ARGOS_MEDIA_MAX_BYTES=10485760
ARGOS_MEDIA_MAX_BYTES_PER_OWNER=1073741824
ARGOS_MEDIA_MAX_CONCURRENT_UPLOADS=4
# Solo pruebas (REQ-PG-001, T418): URL de la base PostgreSQL desechable de docker-compose.test.yml. Sin ella, las pruebas de
# PostgreSQL se omiten con motivo. Marcador comentado, sin valor: el comando para definirla está en docker-compose.test.yml.
# TEST_DATABASE_URL=
