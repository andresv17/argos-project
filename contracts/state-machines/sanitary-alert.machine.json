{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "STATE-ALERT-001",
  "version": "2.0.0",
  "status": "LOCKED",
  "supersedes": "1.0.0",
  "x-sdd-metadata": {
    "version": "2.0.0",
    "status": "LOCKED",
    "traceability": [
      "STATE-ALERT-001",
      "REQ-REC-003",
      "REQ-REC-004",
      "REQ-UI-003"
    ],
    "change_note": "MAJOR: el archivo contiene solo STATE-ALERT-001; STATE-BACKUP-001 se movió a backup-import.machine.json; STATE-PET-QUOTA-001 retirado."
  },
  "machines": {
    "STATE-ALERT-001": {
      "description": "Evaluación determinista de alertas sanitarias para Vacunación y Desparasitación",
      "initial": "EVALUATING",
      "context": {
        "targetDate": "YYYY-MM-DD (nextBoosterAt o nextSuggestedDoseAt)",
        "currentDate": "YYYY-MM-DD de ClockPort.todayIsoDate()",
        "hasNewerRecordOfSameKey": "boolean: existe registro posterior (orden INV-SORT-001) para la misma mascota con mismo vaccineName.trim().toLowerCase() o mismo dewormingType"
      },
      "evaluationOrder": [
        "SUPERSEDED",
        "OVERDUE",
        "DUE_SOON",
        "UP_TO_DATE"
      ],
      "states": {
        "SUPERSEDED": {
          "guard": "hasNewerRecordOfSameKey === true",
          "uiBadge": "NEUTRAL_GRAY",
          "label": "Histórico reemplazado",
          "isActiveAlert": false
        },
        "OVERDUE": {
          "guard": "hasNewerRecordOfSameKey === false && daysRemaining < 0",
          "uiBadge": "DANGER_RED",
          "label": "Vencida",
          "isActiveAlert": true
        },
        "DUE_SOON": {
          "guard": "hasNewerRecordOfSameKey === false && daysRemaining >= 0 && daysRemaining <= 15",
          "uiBadge": "WARNING_AMBER",
          "label": "Próxima a vencer (<= 15 días)",
          "isActiveAlert": true
        },
        "UP_TO_DATE": {
          "guard": "hasNewerRecordOfSameKey === false && daysRemaining > 15",
          "uiBadge": "SUCCESS_GREEN",
          "label": "Al día",
          "isActiveAlert": false
        }
      }
    }
  }
}
