{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "STATE-AUTH-SESSION-001",
  "version": "2.1.0",
  "status": "LOCKED",
  "x-sdd-metadata": {
    "version": "2.1.0",
    "status": "LOCKED",
    "traceability": [
      "STATE-AUTH-SESSION-001",
      "REQ-AUTH-001",
      "REQ-AUTH-002",
      "REQ-AUTH-003",
      "REQ-AUTH-004",
      "INV-AUTH-004",
      "INV-AUTH-005",
      "INV-AUTH-006"
    ],
    "supersedes": "2.0.0",
    "change_type": "MINOR"
  },
  "machines": {
    "STATE-AUTH-SESSION-001": {
      "description": "Ciclo de vida de una sesión de usuario",
      "initial": "ANONYMOUS",
      "constants": {
        "SESSION_TTL_DAYS": 7,
        "MAX_FAILED_ATTEMPTS": 5,
        "LOCKOUT_WINDOW_MINUTES": 15
      },
      "states": {
        "ANONYMOUS": {
          "on": {
            "REGISTER_SUCCESS": "AUTHENTICATED",
            "LOGIN_SUCCESS": {
              "target": "AUTHENTICATED",
              "guard": "!isLockedOut(username, now)",
              "effect": "resetFailedAttempts(username)"
            },
            "LOGIN_FAILURE": {
              "target": "ANONYMOUS",
              "error": "ERR-AUTH-INVALID-CREDENTIALS",
              "effect": "recordFailedAttempt(username, now)"
            },
            "LOGIN_LOCKED": {
              "target": "ANONYMOUS",
              "error": "ERR-AUTH-TOO-MANY-ATTEMPTS",
              "guard": "failedAttempts(username, last 15 min) >= 5"
            },
            "ACCESS_PROTECTED": {
              "target": "ANONYMOUS",
              "error": "ERR-AUTH-UNAUTHENTICATED"
            }
          }
        },
        "AUTHENTICATED": {
          "on": {
            "REQUEST": {
              "target": "AUTHENTICATED",
              "guard": "now < expiresAt && !revoked"
            },
            "TTL_ELAPSED": {
              "target": "EXPIRED",
              "guard": "now >= expiresAt"
            },
            "LOGOUT": "LOGGED_OUT"
          }
        },
        "EXPIRED": {
          "type": "final",
          "onAccess": "ERR-AUTH-UNAUTHENTICATED"
        },
        "LOGGED_OUT": {
          "type": "final",
          "onAccess": "ERR-AUTH-UNAUTHENTICATED"
        }
      },
      "rules": {
        "lockoutWindow": "Ventana deslizante de LOCKOUT_WINDOW_MINUTES contada desde el instante de cada fallo registrado [INV-AUTH-005]",
        "blockedAttemptsRecorded": false,
        "successResetsCounter": "Un LOGIN_SUCCESS elimina los fallos registrados de ese username",
        "userExistence": "El bloqueo aplica igual a usernames inexistentes (anti-enumeración)"
      }
    }
  }
}
