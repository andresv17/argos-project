{
  "$schema": "https://git.io/stryker-schema",
  "packageManager": "npm",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "!src/generated/**"
  ],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  },
  "reporters": ["clear-text", "progress", "html"]
}
