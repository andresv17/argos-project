{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argos.local/contracts/schemas/medical-records.schema.json",
  "title": "MedicalRecordsSchema",
  "description": "6 colecciones de registro histórico con peso por especie, campos clínicos completos y dosis opcional [REQ-REC2-001..003, REQ-REC-002/005/006]",
  "x-sdd-metadata": {
    "version": "3.0.0",
    "status": "REVIEW",
    "supersedes": "2.1.1",
    "change_type": "MAJOR",
    "change_note": "MAJOR: peso 0.001-150 kg con tabla por especie (cota provisional), vacunas y desparasitaciones con veterinario, colegiado y próxima fecha opcional.",
    "traceability": [
      "REQ-REC2-001",
      "REQ-REC2-002",
      "REQ-REC2-003",
      "REQ-REC-002",
      "REQ-REC-005",
      "REQ-REC-006",
      "INV-REC2-002",
      "INV-REC-001",
      "INV-REC-003",
      "INV-REC-004",
      "INV-REC-005",
      "INV-REC-006",
      "INV-PET-003",
      "INV-SORT-001",
      "STATE-ALERT-001"
    ]
  },
  "$defs": {
    "AlertStatus": {
      "type": "string",
      "enum": [
        "UP_TO_DATE",
        "DUE_SOON",
        "OVERDUE",
        "SUPERSEDED"
      ]
    },
    "SpeciesWeightLimits": {
      "const": {
        "CANINE": {
          "minKg": 0.05,
          "maxKg": 150.0,
          "decimals": 2,
          "status": "VALIDATED_BY_SPEC"
        },
        "FELINE": {
          "minKg": 0.05,
          "maxKg": 150.0,
          "decimals": 2,
          "status": "VALIDATED_BY_SPEC"
        },
        "RABBIT": {
          "minKg": 0.001,
          "maxKg": 150.0,
          "decimals": 3,
          "status": "PROVISIONAL_MAX_TO_VALIDATE_BY_VET"
        },
        "FERRET": {
          "minKg": 0.001,
          "maxKg": 150.0,
          "decimals": 3,
          "status": "PROVISIONAL_MAX_TO_VALIDATE_BY_VET"
        },
        "BIRD": {
          "minKg": 0.001,
          "maxKg": 150.0,
          "decimals": 3,
          "status": "PROVISIONAL_MAX_TO_VALIDATE_BY_VET"
        },
        "REPTILE": {
          "minKg": 0.001,
          "maxKg": 150.0,
          "decimals": 3,
          "status": "PROVISIONAL_MAX_TO_VALIDATE_BY_VET"
        },
        "SMALL_MAMMAL": {
          "minKg": 0.001,
          "maxKg": 150.0,
          "decimals": 3,
          "status": "PROVISIONAL_MAX_TO_VALIDATE_BY_VET"
        },
        "OTHER": {
          "minKg": 0.001,
          "maxKg": 150.0,
          "decimals": 3,
          "status": "PROVISIONAL_MAX_TO_VALIDATE_BY_VET"
        }
      },
      "description": "Tabla de INV-REC2-002 (Maggie, F4). El mínimo 0.001 kg y los 3 decimales están decididos (7B); la cota máxima de 150.000 kg para las seis especies pequeñas es PROVISIONAL, a validar por un veterinario (M1). Es una cota de plausibilidad de captura, no un límite clínico. Sin alertas automáticas de peso ni de edad para ninguna especie [INV-REC2-002, SC-013]"
    },
    "WeightRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "petId",
        "recordedAt",
        "weightKg",
        "notes",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/Uuid"
        },
        "petId": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/Uuid"
        },
        "recordedAt": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/IsoDate"
        },
        "weightKg": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 150.0,
          "multipleOf": 0.001,
          "description": "Envolvente general (0.001-150, 3 decimales). El dominio estrecha por especie con SpeciesWeightLimits: CANINE/FELINE 0.05-150.00 con 2 decimales [INV-REC2-002]",
          "x-sdd-error": "ERR-REC-WEIGHT-OUT-OF-RANGE"
        },
        "notes": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/OptionalNotes"
        },
        "createdAt": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/IsoTimestamp"
        }
      }
    },
    "CreateWeightInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordedAt",
        "weightKg"
      ],
      "properties": {
        "recordedAt": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/IsoDate"
        },
        "weightKg": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 150.0,
          "multipleOf": 0.001,
          "description": "Envolvente general (0.001-150, 3 decimales). El dominio estrecha por especie con SpeciesWeightLimits: CANINE/FELINE 0.05-150.00 con 2 decimales [INV-REC2-002]",
          "x-sdd-error": "ERR-REC-WEIGHT-OUT-OF-RANGE"
        },
        "notes": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/OptionalNotes"
        }
      },
      "description": "petId llega por la ruta; id y createdAt los asigna el servidor vía IdGeneratorPort/ClockPort"
    },
