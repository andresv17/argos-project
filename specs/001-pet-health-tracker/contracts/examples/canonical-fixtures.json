  "invalidEdgeCases": [
    {
      "caseId": "EDGE-001-UNLIMITED-PETS",
      "expectedResult": "SUCCESS",
      "invariant": "REQ-PET-001",
      "description": "Registrar un 3er perro y un 5º animal es válido (cupo retirado en v2.0.0)."
    },
    {
      "caseId": "EDGE-002-NEGATIVE-WEIGHT",
      "expectedError": "ERR-REC-WEIGHT-OUT-OF-RANGE",
      "invariant": "INV-REC-002",
      "payload": {
        "weightKg": -2.5
      }
    },
    {
      "caseId": "EDGE-003-BOOSTER-SAME-DAY",
      "expectedError": "ERR-REC-INVALID-BOOSTER-DATE",
      "invariant": "INV-REC-004",
      "payload": {
        "appliedAt": "2026-11-01",
        "nextBoosterAt": "2026-11-01"
      }
    },
    {
      "caseId": "EDGE-004-EVENT-BEFORE-BIRTH",
      "expectedError": "ERR-REC-DATE-BEFORE-BIRTH",
      "invariant": "INV-REC-001",
      "payload": {
        "petBirthDate": "2024-02-14",
        "recordedAt": "2023-12-01"
      }
    },
    {
      "caseId": "EDGE-005-ORPHAN-BACKUP-RECORD",
      "expectedError": "ERR-BACKUP-REFERENTIAL-INTEGRITY",
      "invariant": "INV-BACKUP-001",
      "description": "Registro de peso cuyo petId no existe en pets[].",
      "expectedFinalState": "ROLLED_BACK"
    },
    {
      "caseId": "EDGE-006-FOREIGN-ID-IN-BACKUP",
      "expectedError": "ERR-BACKUP-REFERENTIAL-INTEGRITY",
      "invariant": "INV-BACKUP-001",
      "description": "Andrés importa un sobre que contiene el id de Luna (mascota de María).",
      "expectedFinalState": "ROLLED_BACK"
    },
    {
      "caseId": "EDGE-007-BIRTHDATE-AFTER-RECORDS",
      "expectedError": "ERR-PET-BIRTHDATE-AFTER-RECORDS",
      "invariant": "INV-PET-006",
      "payload": {
        "petId": "11111111-1111-4111-8111-111111111101",
        "birthDate": "2026-10-15"
      },
      "description": "Argos tiene un peso del 2026-10-01."
    },
    {
      "caseId": "EDGE-008-IDOR-READ",
      "expectedError": "ERR-PET-NOT-FOUND",
      "expectedStatus": 404,
      "invariant": "INV-ACC-001",
      "description": "Carlos (sin hogar compartido ACTIVE) pide la ficha de Argos."
    },
    {
      "caseId": "EDGE-009-HOUSEHOLD-WRITE",
      "expectedError": "ERR-ACC-FORBIDDEN",
      "expectedStatus": 403,
      "invariant": "INV-ACC-002",
      "description": "María (miembro ACTIVE) intenta registrar un peso a Argos."
    },
    {
      "caseId": "EDGE-010-USERNAME-TAKEN",
      "expectedError": "ERR-AUTH-USERNAME-TAKEN",
      "invariant": "INV-AUTH-001",
      "payload": {
        "username": "ANDRES",
        "displayName": "Otro",
        "password": "Clave2026x"
      }
    },
    {
      "caseId": "EDGE-011-WEAK-PASSWORD",
      "expectedError": "ERR-AUTH-WEAK-PASSWORD",
      "invariant": "INV-AUTH-002",
      "payload": {
        "username": "nuevo",
        "displayName": "Nuevo",
        "password": "abcdefgh"
      }
    },
    {
      "caseId": "EDGE-012-LOGIN-ENUMERATION",
      "expectedError": "ERR-AUTH-INVALID-CREDENTIALS",
      "invariant": "INV-AUTH-006",
      "description": "Usuario inexistente y contraseña errónea devuelven el mismo código, status y detail."
    },
    {
      "caseId": "EDGE-013-LOCKOUT",
      "expectedError": "ERR-AUTH-TOO-MANY-ATTEMPTS",
      "invariant": "INV-AUTH-005",
      "description": "6º intento fallido para 'andres' en 15 minutos (incluso con contraseña correcta)."
    },
