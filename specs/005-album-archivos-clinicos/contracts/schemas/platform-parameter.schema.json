{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argos.local/contracts/005/schemas/platform-parameter.schema.json",
  "title": "PlatformParameterSchema",
  "description": "Parámetros de plataforma en base de datos (feature 005) [REQ-PRM-001, REQ-PRM-002, REQ-PRM-003]. Sin endpoint ni interfaz de edición; este esquema fija el catálogo de claves conocidas y la forma de la fila para el repositorio y las pruebas de paridad.",
  "x-sdd-metadata": {
    "version": "1.0.0",
    "status": "DRAFT",
    "supersedes": null,
    "change_type": "MAJOR",
    "change_note": "Contrato nuevo de la feature 005 (T706).",
    "traceability": [
      "REQ-PRM-001",
      "REQ-PRM-002",
      "REQ-PRM-003",
      "SC-005-004"
    ]
  },
  "$defs": {
    "ParameterKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,63}$"
    },
    "KnownParameterKey": {
      "type": "string",
      "enum": [
        "album.max_photos_per_pet"
      ],
      "description": "Catálogo cerrado en código; una clave nueva exige tocar dominio, siembra y este contrato"
    },
    "ParameterValueType": {
      "type": "string",
      "enum": [
        "INTEGER",
        "TEXT",
        "BOOLEAN"
      ]
    },
    "PlatformParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "valueType",
        "value",
        "minValue",
        "maxValue",
        "description",
        "updatedAt",
        "updatedByUserId"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/ParameterKey"
        },
        "valueType": {
          "$ref": "#/$defs/ParameterValueType"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Texto canónico; el dominio lo interpreta según valueType; fuera de rango o ilegible = valor por defecto del código + aviso sin datos [REQ-PRM-002]"
        },
        "minValue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maxValue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "updatedAt": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/IsoTimestamp"
        },
        "updatedByUserId": {
          "oneOf": [
            {
              "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sin FK: el perfil de administrador de plataforma aún no existe [REQ-PRM-003]"
        }
      },
      "description": "Fila de platform_parameters"
    },
    "ParameterDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "album.max_photos_per_pet"
      ],
      "properties": {
        "album.max_photos_per_pet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valueType",
            "default",
            "min",
            "max"
          ],
          "properties": {
            "valueType": {
              "const": "INTEGER"
            },
            "default": {
              "const": 10
            },
            "min": {
              "const": 1
            },
            "max": {
              "const": 50
            }
          }
        }
      },
      "description": "Valores por defecto y rango declarados en el código (única fuente cuando la fila falta) [REQ-PRM-002]"
    }
  }
}
