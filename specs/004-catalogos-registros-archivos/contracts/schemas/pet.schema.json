      "pattern": "^(?!(\\d)\\1{14}$)(?!(?:012345678901234|098765432109876|123456789012345|109876543210987|234567890123456|210987654321098|345678901234567|321098765432109|456789012345678|432109876543210|567890123456789|543210987654321|678901234567890|654321098765432|789012345678901|765432109876543|890123456789012|876543210987654|901234567890123|987654321098765)$)\\d{15}$",
