            "properties": {
              "deceasedAt": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "lifeStatus": {
                "const": "ALIVE"
              }
            },
            "required": [
              "lifeStatus"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "deceasedAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
