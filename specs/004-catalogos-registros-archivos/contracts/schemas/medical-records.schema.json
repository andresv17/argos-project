    "CustomParameterRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "petId",
        "recordedAt",
        "category",
        "title",
        "description",
        "notes",
        "createdAt",
        "revision",
        "symptomType",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/Uuid"
        },
        "petId": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/Uuid"
        },
        "recordedAt": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/IsoDate"
        },
        "category": {
          "type": "string",
          "enum": [
            "DIET_CHANGE",
            "ALLERGY",
            "SURGERY",
            "BEHAVIOR",
            "OTHER",
            "SYMPTOM"
          ]
        },
        "title": {
          "type": "string",
          "allOf": [
            {
              "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/NonEmptyTrimmedString"
            }
          ],
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "allOf": [
            {
              "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/NonEmptyTrimmedString"
            }
          ],
          "maxLength": 1000
        },
        "notes": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/OptionalNotes"
        },
        "createdAt": {
          "$ref": "https://argos.local/contracts/schemas/common.schema.json#/$defs/IsoTimestamp"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "readOnly": true,
          "description": "Revisión del registro para If-Match; solo lectura, nunca entrada ni parte del respaldo [REQ-BOR-005, D-16 A]"
        },
        "symptomType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "VOMIT",
            "APPETITE",
            "STOOL",
            "ENERGY",
            null
          ],
          "description": "Catálogo cerrado de síntomas; VOMIT oculto para RABBIT y SMALL_MAMMAL es solo presentación (D-17 A) [INV-SIN-001]"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "MILD",
            "MODERATE",
            "SEVERE",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "category": {
                "const": "SYMPTOM"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "symptomType",
              "severity"
            ],
            "properties": {
              "symptomType": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "symptomType": {
                "type": "null"
              },
              "severity": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
